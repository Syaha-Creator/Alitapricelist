API_BASE_URL=https://api.example.com

# The Alita REST API registers a different client_id/client_secret per
# platform — using the wrong pair makes /sign_in reject an otherwise-correct
# login with 401. See lib/core/config/app_config.dart.
API_CLIENT_ID_ANDROID=changeme
API_CLIENT_SECRET_ANDROID=changeme
API_CLIENT_ID_IOS=changeme
API_CLIENT_SECRET_IOS=changeme

API_TIMEOUT_MS=15000
CRASHLYTICS_ENABLED=true
